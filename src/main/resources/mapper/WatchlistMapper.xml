<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cloudhandson.tossstock.watchlist.WatchlistMapper">

    <select id="findAll" resultType="Watchlist">
        SELECT id, symbol, memo, created_at
        FROM watchlist
        ORDER BY id
    </select>

    <select id="findBySymbol" parameterType="string" resultType="Watchlist">
        SELECT id, symbol, memo, created_at
        FROM watchlist
        WHERE symbol = #{symbol}
        FETCH FIRST 1 ROWS ONLY
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM watchlist WHERE id = #{id}
    </delete>

    <!-- Oracle IDENTITY 키 반환: keyColumn 명시 필수(미지정 시 ROWID 반환 → ORA-17132) -->
    <insert id="insert" parameterType="Watchlist" useGeneratedKeys="true" keyProperty="id" keyColumn="ID">
        INSERT INTO watchlist (symbol, memo, created_at)
        VALUES (#{symbol}, #{memo}, CURRENT_TIMESTAMP)
    </insert>

</mapper>
