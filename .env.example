# ============================================================
# toss-stock-app — 환경설정. `cp .env.example .env` 후 값을 채우세요.
# 핵심 기능(탑50·워치리스트·내 보유·시세)은 [필수] 항목만으로 동작합니다.
# 테이블은 기동 시 자동 생성(멱등)됩니다.
# ============================================================

# ===== [필수] 토스증권 Open API =====
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ===== [필수] Oracle Autonomous DB (mTLS 월렛) =====
# OCI 콘솔에서 받은 월렛 폴더의 절대경로(자동로그인 cwallet.sso 포함).
ORACLE_TNS_ADMIN=/absolute/path/to/Wallet_XXXX
ORACLE_SERVICE=xxxx_tp          # tnsnames.ora 의 서비스명(_tp / _high / _low)
ORACLE_USER=admin
ORACLE_PASSWORD=

# ===== [선택] 뉴스 분류 LLM (OpenAI 호환) =====
# 키가 있으면 '뉴스(S1~S5 호재/악재)' 기능 활성. 없으면 핵심 기능만 동작.
# OpenAI · OpenRouter · 로컬(ollama/vLLM) 등 OpenAI 호환 엔드포인트면 무엇이든 가능.
LLM_BASE_URL=https://api.openai.com/v1       # OpenRouter: https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini                        # OpenRouter 예: anthropic/claude-haiku-4.5
# NEWS_RSS_FEEDS=https://www.hankyung.com/feed/finance,https://www.yna.co.kr/rss/economy.xml

# ===== [선택] 서버 포트 (기본 8080) =====
# SERVER_PORT=8080

# ===== [개발 전용] Redmine/Gitea 페르소나 파이프라인 (운영에는 불필요) =====
# REDMINE_URL=
# REDMINE_API_KEY=
# REDMINE_PROJECT=toss-stock-app
# GITEA_URL=
# GITEA_USER=
# GITEA_EMAIL=
# GITEA_REPO=toss-stock-app
